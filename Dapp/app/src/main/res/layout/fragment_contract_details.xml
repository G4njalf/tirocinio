<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?android:attr/windowBackground"
    tools:context=".ui.contract_detail.ContractDetailFragment">

    <!-- Titolo se vuoi -->

    <!-- Blocco informazioni -->
    <LinearLayout
        android:id="@+id/infoBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/addressTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Address:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premioTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Premium:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/isLiquidatoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Liquidated:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/isAttivatoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Activated:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/isFundendTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Funded:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/addressAssicuratoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Client:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/addressAssicuratoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Ensurer:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/requestIdTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Request Id:"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Pulsanti -->
    <LinearLayout
        android:id="@+id/buttonBlock"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/activateContractbtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activate Contract"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/fundContractbtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fund Contract"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/liquidateContractBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liquidate Contract"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- ProgressBar centrata sopra i pulsanti -->
    <ProgressBar
        android:id="@+id/progressBarDetail"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:indeterminate="false"
        android:progress="0"
        android:max ="100"
        android:progressTint="@color/clr_primary_a10"
        app:layout_constraintTop_toBottomOf="@id/infoBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonBlock"/>
</androidx.constraintlayout.widget.ConstraintLayout>
